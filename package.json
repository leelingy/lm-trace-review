{
  "name": "lm-trace-review",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"vite\"",
    "server": "cd server && npm start",
    "frontend": "vite",
    "build": "vite build",
    "deploy": "GITHUB_ACTIONS=true npm run build && cd dist && git init -b gh-pages && git add -A && git commit -m \"Deploy LM Trace Review\" && git push -f https://github.com/leelingy/lm-trace-review.git gh-pages && cd .. && rm -rf dist/.git",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "dompurify": "^3.3.0",
    "marked": "^17.0.0",
    "papaparse": "^5.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "vite": "^7.1.7"
  }
}
